#include <behaviors.dtsi>
// https://github.com/urob/zmk-unicode
#include <behaviors/unicode.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

&uc {
  // This lets zmk-unicode use wincompose to make unicode characters
  // Advantage might be that it has to send fewer characters
  // Assumes you are running https://github.com/samhocevar/wincompose
  default-mode = <UC_MODE_WIN_COMPOSE>;
  win-compose-key = <RALT>;
};

// caps_word is not great if you are running dvorak layout on windows:
// QWERTY locations ',.; are considered non-alpha-numeric by the keyboard before dvorak resolution in the OS
// We would need to remove them from the "continue-list", but we can only add things to the continue-list:
&caps_word {
    continue-list = <UNDERSCORE MINUS COMMA DOT FSLH SEMI SQT>;
};
    
// Machine-local macros live in local_macros.dtsi (not tracked in git).
// If that file is absent, lmacro1/lmacro2 fall back to no-ops so the build still works.
#if __has_include("local_macros.dtsi")
#include "local_macros.dtsi"
#else
/ {
    macros {
        ZMK_MACRO(lmacro1, bindings = <&none>;)
        ZMK_MACRO(lmacro2, bindings = <&none>;)
    };
};
#endif

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &lmacro1   &kp ESC           &kp F1       &kp F2       &kp F3       &kp F4      &kp F5      &kp F6        &kp F7       &kp F8       &kp F9       &kp F10      &kp F11      &kp F12      &kp DEL
            &kp F14    &kp GRAVE         &kp N1       &kp N2       &kp N3       &kp N4      &kp N5      &kp N6        &kp N7       &kp N8       &kp N9       &kp N0       &kp MINUS    &kp EQUAL    &kp BSPC
            &kp F15    &kp TAB           &kp Q        &kp W        &kp E        &kp R       &kp T                     &kp Y        &kp U        &kp I        &kp O        &kp P        &kp LBKT     &kp RBKT     &kp BSLH
            &caps_word &kp RCTRL         &kp A        &kp S        &kp D        &kp F       &kp G                     &kp H        &kp J        &kp K        &kp L        &kp SEMI     &kp SQT      &kp ENTER
            &kp F17    &kp LSHFT         &kp Z        &kp X        &kp C        &kp V       &kp B                     &kp N        &kp M        &kp COMMA    &kp DOT      &kp FSLH     &kp RSHFT
            &lmacro2   &kp LCTRL         &mo 1        &kp LGUI     &kp LALT     &kp SPACE                             &kp ENTER    &kp RALT     &mo 1        &kp PG_UP    &kp UP       &kp PG_DN
                                                                                                                                                              &kp LEFT     &kp DOWN     &kp RIGHT
            >;
        };

        system_layer {
            bindings = <
            &trans     &ext_power EP_OFF &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 3 &trans      &trans      &trans        &trans       &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP &kp SLCK     &kp PSCRN    &kp INS
            &trans     &trans            &bootloader  &bt BT_CLR   &sys_reset   &soft_off   &trans      &trans        &bootloader  &bt BT_CLR   &sys_reset   &soft_off    &trans       &trans       &trans
            &trans     &trans            &trans       &trans       &trans       &trans      &trans                    &trans       &trans       &trans       &trans       &trans       &trans       &trans      &trans
            &trans     &trans            &trans       &uc UC_DE_OE &trans       &trans      &trans                    &trans       &trans       &trans       &trans       &trans       &trans       &trans
            &trans     &trans            &trans       &trans       &trans       &trans      &trans                    &trans       &trans       &trans       &trans       &trans       &trans
            &trans     &trans            &trans       &trans       &trans       &trans                                &trans       &trans       &trans       &trans       &trans       &trans
                                                                                                                                                      &trans       &trans       &trans
            >;
        };

        unicode_layer {
            bindings = <
            &trans     &trans     &trans       &trans       &trans       &trans      &trans      &trans        &trans       &trans       &trans       &trans       &trans       &trans       &trans
            &trans     &trans     &trans       &trans       &trans       &trans      &trans      &trans        &trans       &trans       &trans       &trans       &trans       &trans       &trans
            &trans     &trans     &trans       &trans       &trans       &trans      &trans                    &trans       &trans       &trans       &trans       &trans       &trans       &trans      &trans
            &trans     &trans     &trans       &trans       &trans       &trans      &trans                    &trans       &trans       &trans       &trans       &trans       &trans       &trans
            &trans     &trans     &trans       &trans       &trans       &trans      &trans                    &trans       &trans       &trans       &trans       &trans       &trans
            &trans     &trans     &trans       &trans       &trans       &trans                                &trans       &trans       &trans       &trans       &trans       &trans
                                                                                                                                                      &trans       &trans       &trans
            >;
            
        };
    };
};