#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col";
        wakeup-source;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <22>;
        rows = <8>;
        map = <
        RC(0, 9)  RC(3, 0)  RC(6, 1) RC(6, 2)  RC(1, 2) RC(3, 2) RC(7, 10) RC(3, 5)    RC(1, 14) RC(6, 14) RC(6, 18) RC(7, 18) RC(3, 18) RC(5, 18) RC(6, 16)
        RC(7, 9)  RC(6, 0)  RC(7, 0) RC(7, 1)  RC(7, 2) RC(7, 3) RC(6, 3)  RC(6, 4)    RC(7, 12) RC(7, 13) RC(7, 14) RC(7, 19) RC(6, 19) RC(6, 13) RC(1, 18)
        RC(0, 10) RC(1, 0)  RC(0, 0) RC(0, 1)  RC(0, 2) RC(0, 3) RC(1, 3)              RC(1, 12) RC(0, 12) RC(0, 13) RC(0, 14) RC(0, 19) RC(1, 19) RC(1, 13) RC(2, 18)
        RC(4, 7)  RC(1, 1)  RC(2, 0) RC(2, 1)  RC(2, 2) RC(2, 3) RC(3, 3)              RC(3, 12) RC(2, 12) RC(2, 13) RC(2, 14) RC(2, 19) RC(3, 19) RC(4, 18)
        RC(6, 6)  RC(1, 8)  RC(4, 0) RC(4, 1)  RC(4, 2) RC(4, 3) RC(5, 3)              RC(5, 12) RC(4, 12) RC(4, 13) RC(4, 14) RC(5, 19) RC(2, 17)
        RC(7, 6)  RC(6, 10) RC(2, 9) RC(1, 11) RC(3, 9) RC(3, 7)                       RC(3, 16) RC(5, 20) RC(4, 21) RC(6, 15) RC(3, 14) RC(7, 15)
                                                                                                                     RC(5, 14) RC(5, 16) RC(5, 15)
        >;
    };

};