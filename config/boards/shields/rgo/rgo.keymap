#include <behaviors.dtsi>
// https://github.com/urob/zmk-unicode
#include <behaviors/unicode.dtsi>
// Record-and-play macros, see recmac/ in this repo.
// The far-left column is six slots, top to bottom: rm0 rm2 rm3 rm4 rm5 rm1.
// Fn+key records (press again to stop and save), key alone plays back.
// Use the right Fn for the top two: left Fn shares their matrix column and doesn't register with them.
#include <behaviors/recorded_macro.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

&uc {
  // This lets zmk-unicode use wincompose to make unicode characters
  // Advantage might be that it has to send fewer characters
  // Assumes you are running https://github.com/samhocevar/wincompose
  default-mode = <UC_MODE_WIN_COMPOSE>;
  win-compose-key = <RALT>;
};

// caps_word is not great if you are running dvorak layout on windows:
// QWERTY locations ',.; are considered non-alpha-numeric by the keyboard before dvorak resolution in the OS
// We would need to remove them from the "continue-list", but we can only add things to the continue-list:
&caps_word {
    continue-list = <UNDERSCORE MINUS COMMA DOT FSLH SEMI SQT>;
};
    

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &rm0 RM_PLAY &kp ESC           &kp F1       &kp F2       &kp F3       &kp F4       &kp F5       &kp F6       &kp F7       &kp F8       &kp F9       &kp F10      &kp F11      &kp F12      &kp DEL
            &rm2 RM_PLAY &kp GRAVE         &kp N1       &kp N2       &kp N3       &kp N4       &kp N5       &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &kp MINUS    &kp EQUAL    &kp BSPC
            &rm3 RM_PLAY &kp TAB           &kp Q        &kp W        &kp E        &kp R        &kp T                     &kp Y        &kp U        &kp I        &kp O        &kp P        &kp LBKT     &kp RBKT     &kp BSLH
            &rm4 RM_PLAY &kp RCTRL         &kp A        &kp S        &kp D        &kp F        &kp G                     &kp H        &kp J        &kp K        &kp L        &kp SEMI     &kp SQT      &kp ENTER
            &rm5 RM_PLAY &kp LSHFT         &kp Z        &kp X        &kp C        &kp V        &kp B                     &kp N        &kp M        &kp COMMA    &kp DOT      &kp FSLH     &kp RSHFT
            &rm1 RM_PLAY &kp LCTRL         &mo 1        &kp LGUI     &kp LALT     &kp SPACE                              &kp ENTER    &kp RALT     &mo 1        &kp PG_UP    &kp UP       &kp PG_DN
                                                                                                                                                                &kp LEFT     &kp DOWN     &kp RIGHT
            >;
        };

        system_layer {
            bindings = <
            &rm0 RM_REC  &ext_power EP_OFF &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 3 &trans       &trans       &trans       &trans       &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP &kp SLCK     &kp PSCRN    &kp INS
            &rm2 RM_REC  &trans            &bootloader  &bt BT_CLR   &sys_reset   &soft_off    &trans       &trans       &bootloader  &bt BT_CLR   &sys_reset   &soft_off    &trans       &trans       &trans
            &rm3 RM_REC  &trans            &trans       &trans       &trans       &trans       &trans                    &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans
            &rm4 RM_REC  &trans            &trans       &uc UC_DE_OE &trans       &trans       &trans                    &trans       &trans       &trans       &trans       &trans       &trans       &trans
            &rm5 RM_REC  &trans            &trans       &trans       &trans       &trans       &trans                    &trans       &trans       &trans       &trans       &trans       &trans
            &rm1 RM_REC  &trans            &trans       &trans       &trans       &trans                                 &trans       &trans       &trans       &trans       &trans       &trans
                                                                                                                                                                &trans       &trans       &trans
            >;
        };

        unicode_layer {
            bindings = <
            &trans       &trans            &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans
            &trans       &trans            &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans
            &trans       &trans            &trans       &trans       &trans       &trans       &trans                    &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans
            &trans       &trans            &trans       &trans       &trans       &trans       &trans                    &trans       &trans       &trans       &trans       &trans       &trans       &trans
            &trans       &trans            &trans       &trans       &trans       &trans       &trans                    &trans       &trans       &trans       &trans       &trans       &trans
            &trans       &trans            &trans       &trans       &trans       &trans                                 &trans       &trans       &trans       &trans       &trans       &trans
                                                                                                                                                                &trans       &trans       &trans
            >;
            
        };
    };
};