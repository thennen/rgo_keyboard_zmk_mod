DT_COMPAT_ZMK_BEHAVIOR_RECORDED_MACRO := zmk,behavior-recorded-macro

config ZMK_BEHAVIOR_RECORDED_MACRO
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_RECORDED_MACRO))

if ZMK_BEHAVIOR_RECORDED_MACRO

config ZMK_RECORDED_MACRO_MAX_EVENTS
    int "Maximum events per recorded macro (a keystroke is a press and a release, so 2 events)"
    default 128

config ZMK_RECORDED_MACRO_WAIT_MS
    int "Time to wait (in milliseconds) between events when playing back"
    default 10

config ZMK_RECORDED_MACRO_PASSTHROUGH
    bool "Also send keys to the computer while recording"
    default n

endif
